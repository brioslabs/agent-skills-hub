# ==============================================================================
# BriosLabs Agent Skills Hub - .gitignore
# ==============================================================================
# Garantiza que únicamente se versionen las skills finalizadas, scripts y docs,
# excluyendo cualquier contexto de conversación, logs, borradores o trazas de IA.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Agents, Assistants & Conversation Context
# ------------------------------------------------------------------------------
# Gemini / Antigravity / Agent CLI context & brain directories
.gemini/
.antigravity/
.brain/
brain/
artifacts/
transcripts/
*.transcript.*
*.jsonl
scratch/
scratchpad*
*.scratch.*
*.draft.md
*.prompt.md
*.plan.md

# Claude / Cursor / Windsurf / Cline / Roo / Aider / Continue / Copilot contexts
.claude/
claude_transcripts/
.cursor/
.windsurf/
.cline/
.roo/
.aider*
.continue/
.chat/
chats/
conversations/
*.conversation.*
*.chat.*

# ------------------------------------------------------------------------------
# 2. Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 3. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
!.env.example

# ------------------------------------------------------------------------------
# 4. Python Environment & Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# ------------------------------------------------------------------------------
# 5. Node.js & Package Managers
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 6. IDEs & Operating System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
